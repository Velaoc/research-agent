<section class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold">Invite a member</h1>
  <p class="mt-1 text-sm text-md-on-surface-variant">
    They will receive an email link to join <%= current_organization.name %>.
  </p>

  <%= form_with model: @invitation, url: organization_invitations_path, class: "mt-6 space-y-5" do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium" %>
      <%= f.email_field :email, required: true, autofocus: true,
            class: "mt-1 block w-full rounded-md border border-md-outline px-3 py-2" %>
    </div>
    <div>
      <%= f.label :role, class: "block text-sm font-medium" %>
      <%= f.select :role, [ [ "member", "member" ], [ "admin", "admin" ] ], {},
            class: "mt-1 block w-full rounded-md border border-md-outline px-3 py-2" %>
    </div>
    <%= f.submit "Send invitation",
          class: "w-full md-button md-button--filled" %>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Back to members", memberships_path, class: "underline underline-offset-2 hover:text-md-on-surface-variant" %>
  </p>
</section>
