<section class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold">New organization</h1>

  <%= form_with model: @organization, url: organizations_path, class: "mt-6 space-y-5" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "mt-1 block w-full rounded-md border border-md-outline px-3 py-2" %>
    </div>
    <%= f.submit "Create organization",
          class: "w-full md-button md-button--filled" %>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Back to organizations", organizations_path, class: "underline underline-offset-2 hover:text-md-on-surface-variant" %>
  </p>
</section>
