<%= mail_heading "Confirm your email" %>

<%= mail_paragraph do %>
  Welcome <%= @email %>. Confirm your account email with the button below.
<% end %>

<%= mail_button "Confirm my account", confirmation_url(@resource, confirmation_token: @token) %>

<%= mail_muted do %>
  If the button does not work, copy this address into your browser:
<% end %>
<p style="<%= mail_url_style %>"><%= confirmation_url(@resource, confirmation_token: @token) %></p>
