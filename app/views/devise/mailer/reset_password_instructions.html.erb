<%= mail_heading "Reset your password" %>

<%= mail_paragraph do %>
  Hello <%= @resource.email %>. Someone has requested a link to change your password.
<% end %>

<%= mail_button "Change my password", edit_password_url(@resource, reset_password_token: @token) %>

<%= mail_muted do %>
  If the button does not work, copy this address into your browser:
<% end %>
<p style="<%= mail_url_style %>"><%= edit_password_url(@resource, reset_password_token: @token) %></p>

<%= mail_muted do %>
  If you did not request this, you can ignore this email. Your password will not change until you create a new one through the link above.
<% end %>
