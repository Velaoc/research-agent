<section class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold">Resend unlock instructions</h1>

  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "mt-6 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "mt-1 block w-full rounded-md border border-md-outline px-3 py-2" %>
    </div>

    <%= f.submit "Resend unlock instructions", class: "w-full md-button md-button--filled" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
