<% content_for :title, resource.friendly_name.pluralize %>

<header class="header">
  <h1><%= resource.friendly_name.pluralize %></h1>
  <div class="actions">
    <%= form_with url: resource.index_path, method: :get, class: "search" do %>
      <%= search_field_tag :q, params[:q], placeholder: "Search" %>
    <% end %>
    <% resource.collection_actions.each do |action| %>
      <%= instance_exec(&action) %>
    <% end %>
  </div>
</header>

<nav class="scopes" aria-label="Record filters">
  <% resource.scopes.each do |scope| %>
    <%= link_to scope.to_s.humanize, resource.index_path(scope: scope, q: params[:q]),
          class: class_names("btn btn-secondary", active: params[:scope] == scope.to_s) %>
  <% end %>
</nav>

<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <% resource.attributes.values.each do |attribute| %>
          <% next unless attribute.field&.visible?(:index) %>
          <th><%= sortable attribute.name, attribute.field.label %></th>
        <% end %>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <% resource.attributes.values.each do |attribute| %>
            <% next unless attribute.field&.visible?(:index) %>
            <td><%= render partial: attribute.field.to_partial_path("index"), locals: { field: attribute.field, record: record, resource: resource } %></td>
          <% end %>
          <td><%= link_to "View", resource.show_path(record) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="pagination">
  <% if @pagy.respond_to?(:series_nav) %>
    <%== @pagy.series_nav if @pagy.last > 1 %>
    <%== @pagy.info_tag %>
  <% else %>
    <%== pagy_nav @pagy if @pagy.last > 1 %>
    <%== pagy_info @pagy %>
  <% end %>
</div>
