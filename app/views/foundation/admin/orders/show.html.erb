<% content_for :title, "Order #{@order.public_reference}" %><header class="header"><h1>Order <%= @order.public_reference %></h1><%= link_to "All orders", storefront_admin_orders_path, class: "btn btn-secondary" %></header>
<div class="table-scroll"><table><tbody><tr><th>State</th><td><%= @order.state %></td></tr><tr><th>Contact email (PII)</th><td><%= @order.email %></td></tr><tr><th>Account owner ID</th><td><%= @order.user_id || "Guest" %></td></tr><tr><th>Total</th><td><%= storefront_money(@order.total_cents, @order.currency) %></td></tr><tr><th>Stripe session</th><td><%= @order.stripe_session_id.presence || "None" %></td></tr><tr><th>Simulated</th><td><%= @order.simulated? ? "Yes" : "No" %></td></tr><tr><th>Terms / Privacy</th><td><%= @order.terms_version %> / <%= @order.privacy_version %> at <%= l(@order.legal_accepted_at, format: :long) %></td></tr></tbody></table></div>
<h2>Immutable item snapshots</h2><div class="table-scroll"><table><thead><tr><th>Name</th><th>SKU</th><th>Unit</th><th>Quantity</th><th>Total</th></tr></thead><tbody><% @order.line_items.each do |item| %><tr><td><%= item.name %></td><td><%= item.sku %></td><td><%= storefront_money(item.unit_price_cents, item.currency) %></td><td><%= item.quantity %></td><td><%= storefront_money(item.line_total_cents, item.currency) %></td></tr><% end %></tbody></table></div>
<% if @order.pending? %><%= button_to "Cancel pending order and release inventory", cancel_storefront_admin_order_path(@order), class: "btn btn-danger", data: { turbo_confirm: "Cancel this pending order?" } %><% end %>
