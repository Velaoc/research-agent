<% content_for :title, "Storefront payment events" %><header class="header"><h1>Payment events</h1></header><p>Audited identifiers and outcomes only; raw provider payloads and secrets are never stored.</p>
<div class="table-scroll"><table><thead><tr><th>Provider event</th><th>Type</th><th>Status</th><th>Order</th><th>Received</th><th>Details</th></tr></thead><tbody><% @payment_events.each do |event| %><tr><td><%= event.provider_event_id %></td><td><%= event.event_type %></td><td><%= event.status %></td><td><%= event.order&.public_reference || "Unknown" %></td><td><%= l(event.created_at, format: :short) %></td><td><%= link_to "View", storefront_admin_payment_event_path(event) %></td></tr><% end %></tbody></table></div>
