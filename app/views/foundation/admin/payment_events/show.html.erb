<% content_for :title, "Payment event #{@payment_event.provider_event_id}" %><header class="header"><h1>Payment event</h1><%= link_to "All payment events", storefront_admin_payment_events_path, class: "btn btn-secondary" %></header>
<div class="table-scroll"><table><tbody><tr><th>Provider</th><td><%= @payment_event.provider %></td></tr><tr><th>Event ID</th><td><%= @payment_event.provider_event_id %></td></tr><tr><th>Type</th><td><%= @payment_event.event_type %></td></tr><tr><th>Status</th><td><%= @payment_event.status %></td></tr><tr><th>Order ID</th><td><%= @payment_event.order_id || "Unknown" %></td></tr><tr><th>Session ID</th><td><%= @payment_event.provider_session_id.presence || "None" %></td></tr><tr><th>Payment ID</th><td><%= @payment_event.provider_payment_id.presence || "None" %></td></tr><tr><th>Failure code</th><td><%= @payment_event.error_code.presence || "None" %></td></tr><tr><th>Payload SHA-256</th><td><%= @payment_event.payload_digest %></td></tr></tbody></table></div>
