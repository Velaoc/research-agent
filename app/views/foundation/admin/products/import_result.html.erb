<% content_for :title, "Product import result" %><header class="header"><div><h1>Product import result</h1><p><%= @result.created %> created, <%= @result.updated %> updated, <%= @result.errors %> failed.</p></div><%= link_to "Back to products", storefront_admin_products_path, class: "btn" %></header>
<div class="table-scroll"><table><thead><tr><th>Row</th><th>Slug</th><th>Result</th><th>Errors</th></tr></thead><tbody><% @result.rows.each do |row| %><tr><td><%= row.row %></td><td><%= row.slug %></td><td><%= row.status %></td><td><%= row.errors.to_sentence %></td></tr><% end %></tbody></table></div>
