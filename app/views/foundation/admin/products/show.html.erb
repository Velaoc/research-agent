<% content_for :title, @product.name %>
<header class="header"><h1><%= @product.name %></h1><div class="actions"><%= link_to "Edit product", edit_storefront_admin_product_path(@product), class: "btn" %><%= link_to "All products", storefront_admin_products_path, class: "btn btn-secondary" %></div></header>
<div class="table-scroll"><table><tbody><tr><th>Slug</th><td><%= @product.slug %></td></tr><tr><th>SKU</th><td><%= @product.sku %></td></tr><tr><th>Price</th><td><%= storefront_money(@product.price_cents, @product.currency) %></td></tr><tr><th>Inventory</th><td><%= @product.inventory_quantity %></td></tr><tr><th>Available</th><td><%= @product.active? ? "Yes" : "No" %></td></tr><tr><th>Description</th><td><%= simple_format(@product.description) %></td></tr><tr><th>External image</th><td><%= @product.image_url.presence || "None" %></td></tr></tbody></table></div>
<section class="md-card md-card--filled md-stack"><h2>Named inventory actions</h2><%= form_with url: adjust_inventory_storefront_admin_product_path(@product), class: "md-actions" do |form| %><%= form.label :inventory_quantity, "Set inventory" %><%= form.number_field :inventory_quantity, value: @product.inventory_quantity, min: 0, max: 1_000_000, required: true %><%= form.submit "Set inventory" %><% end %><%= button_to(@product.active? ? "Hide product" : "Make product available", set_availability_storefront_admin_product_path(@product), params: { active: !@product.active? }, class: "btn btn-secondary") %></section>
