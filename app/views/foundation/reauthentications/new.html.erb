<section class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold">Confirm it is you</h1>
  <p class="mt-3 text-sm text-md-on-surface-variant">
    For your security, confirm your identity before continuing. This unlocks
    sensitive actions for <%= distance_of_time_in_words(Foundation::Reauthentication::WINDOW) %>.
  </p>

  <% if current_user.password_configured? %>
    <%= form_with url: reauthentication_path, method: :post, class: "mt-6 space-y-5" do %>
      <%= hidden_field_tag :return_to, session[Foundation::Reauthentication::SESSION_RETURN_KEY] %>

      <div>
        <%= label_tag :password, "Password", class: "block text-sm font-medium" %>
        <%= password_field_tag :password, nil,
              autocomplete: "current-password",
              required: true,
              class: "mt-1 block w-full rounded-md border border-md-outline px-3 py-2" %>
      </div>

      <%= submit_tag "Confirm", class: "w-full md-button md-button--filled" %>
    <% end %>
  <% else %>
    <p class="mt-6 text-sm text-md-on-surface-variant">
      This account has no password yet.
      <%= link_to "Set a password", new_user_password_path, class: "underline" %>
      via email, or confirm with a linked provider below.
    </p>
  <% end %>

  <% if @linked_providers.any? %>
    <div class="mt-8">
      <p class="text-sm font-medium">Or confirm with a linked provider</p>
      <ul class="mt-3 space-y-2">
        <% @linked_providers.each do |provider| %>
          <li>
            <%= button_to "Confirm with #{Foundation::Oauth.label(provider)}",
                  oauth_reauthentication_path(provider: provider),
                  method: :post,
                  params: { return_to: session[Foundation::Reauthentication::SESSION_RETURN_KEY] },
                  data: { turbo: false },
                  class: "w-full rounded-md border border-md-outline px-3 py-2 text-sm hover:bg-md-surface-container" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="mt-8 text-sm">
    <%= link_to "Back to devices", settings_sessions_root_path, class: "underline text-md-on-surface-variant" %>
  </p>
</section>
