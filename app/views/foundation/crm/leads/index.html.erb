<% title "Leads" %>

<section class="md-page md-stack">
  <header class="md-actions" style="justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
    <div>
      <p class="md-section__eyebrow">CRM</p>
      <h1>Leads</h1>
    </div>
    <%= link_to "New lead", new_crm_lead_path, class: "md-button md-button--filled" %>
  </header>

  <%= render "foundation/crm/shared/subnav" %>

  <%= form_with url: crm_leads_path, method: :get, class: "md-actions", local: true do %>
    <div class="md-field" style="flex: 1; min-width: 180px;">
      <%= label_tag :q, "Search" %>
      <%= text_field_tag :q, params[:q] %>
    </div>
    <div class="md-field">
      <%= label_tag :status, "Status" %>
      <%= select_tag :status, options_for_select([ [ "Any", "" ] ] + Foundation::Crm::Lead::STATUSES.map { |s| [ s.humanize, s ] }, params[:status]) %>
    </div>
    <%= hidden_field_tag :mine, params[:mine] if params[:mine] == "1" %>
    <%= submit_tag "Filter", class: "md-button md-button--tonal" %>
  <% end %>

  <div class="md-actions" style="flex-wrap: wrap;">
    <%= crm_filter_link "All owners", crm_leads_path(q: params[:q], status: params[:status]), active: params[:mine] != "1" %>
    <%= crm_filter_link "Mine", crm_leads_path(q: params[:q], status: params[:status], mine: "1"), active: params[:mine] == "1" %>
  </div>

  <div class="table-scroll">
    <table>
      <thead><tr><th>Name</th><th>Status</th><th>Source</th><th>Owner</th><th></th></tr></thead>
      <tbody>
        <% @leads.each do |lead| %>
          <tr>
            <td><%= lead.name %></td>
            <td><%= lead.status.humanize %></td>
            <td><%= lead.source %></td>
            <td><%= crm_user_label(lead.owner) %></td>
            <td><%= link_to "View", crm_lead_path(lead) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%
    qs = []
    qs << "q=#{ERB::Util.url_encode(params[:q])}" if params[:q].present?
    qs << "status=#{ERB::Util.url_encode(params[:status])}" if params[:status].present?
    qs << "mine=1" if params[:mine] == "1"
    base = qs.any? ? "#{crm_leads_path}?#{qs.join('&')}" : crm_leads_path
  %>
  <%= crm_pagination(base_path: base, page: @page, has_next: @has_next_page) %>
</section>
