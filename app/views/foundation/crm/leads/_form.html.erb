<%= render "foundation/crm/shared/errors", record: lead %>
<%= form_with model: lead, url: lead.persisted? ? crm_lead_path(lead) : crm_leads_path, class: "md-stack" do |form| %>
  <div class="md-field"><%= form.label :name %><%= form.text_field :name, required: true, maxlength: 200 %></div>
  <div class="md-field"><%= form.label :email %><%= form.email_field :email, maxlength: 254 %></div>
  <div class="md-field"><%= form.label :phone %><%= form.telephone_field :phone, maxlength: 60 %></div>
  <div class="md-field"><%= form.label :source %><%= form.text_field :source, maxlength: 120 %></div>
  <div class="md-field">
    <%= form.label :status %>
    <%= form.select :status, Foundation::Crm::Lead::STATUSES.map { |s| [ s.humanize, s ] } %>
  </div>
  <div class="md-field"><%= form.label :description %><%= form.text_area :description, rows: 4 %></div>
  <div class="md-field">
    <%= form.label :company_id, "Company" %>
    <%= form.collection_select :company_id, @companies, :id, :name, { include_blank: "None" } %>
  </div>
  <div class="md-field">
    <%= form.label :contact_id, "Contact" %>
    <%= form.collection_select :contact_id, @contacts, :id, :display_name, { include_blank: "None" } %>
  </div>
  <div class="md-field">
    <%= form.label :owner_id, "Owner" %>
    <%= form.collection_select :owner_id, @members, :id, :email, { include_blank: "Unassigned" } %>
  </div>
  <div class="md-actions">
    <%= form.submit class: "md-button md-button--filled" %>
    <%= link_to "Cancel", lead.persisted? ? crm_lead_path(lead) : crm_leads_path, class: "md-button md-button--text" %>
  </div>
<% end %>
