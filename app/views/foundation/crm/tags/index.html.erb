<% title "Tags" %>

<section class="md-page md-stack">
  <header>
    <p class="md-section__eyebrow">CRM</p>
    <h1>Tags</h1>
  </header>

  <%= render "foundation/crm/shared/subnav" %>

  <%= render "foundation/crm/shared/errors", record: @tag if @tag&.errors&.any? %>

  <div class="md-card md-card--outlined md-stack">
    <h2>Create tag</h2>
    <%= form_with model: @tag, url: crm_tags_path, class: "md-actions" do |form| %>
      <div class="md-field" style="flex: 1;">
        <%= form.label :name %>
        <%= form.text_field :name, required: true, maxlength: 60 %>
      </div>
      <%= form.submit "Create", class: "md-button md-button--filled" %>
    <% end %>
  </div>

  <div class="table-scroll">
    <table>
      <thead><tr><th>Name</th><th></th></tr></thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td><%= tag.name %></td>
            <td><%= button_to "Delete", crm_tag_path(tag), method: :delete, class: "md-button md-button--text", form: { data: { turbo_confirm: "Delete this tag?" } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
