<% title @opportunity.name %>

<section class="md-page md-stack">
  <header class="md-actions" style="justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
    <div>
      <p class="md-section__eyebrow">Opportunity</p>
      <h1><%= @opportunity.name %></h1>
      <p class="text-md-on-surface-variant">
        <%= @opportunity.pipeline_stage&.name %> · <%= crm_money(@opportunity.amount_cents, @opportunity.currency) %> · <%= @opportunity.status.humanize %>
      </p>
    </div>
    <div class="md-actions">
      <%= link_to "Edit", edit_crm_opportunity_path(@opportunity), class: "md-button md-button--tonal" %>
      <%= button_to "Delete", crm_opportunity_path(@opportunity), method: :delete, class: "md-button md-button--text", form: { data: { turbo_confirm: "Delete this opportunity?" } } %>
    </div>
  </header>

  <%= render "foundation/crm/shared/subnav" %>

  <div class="table-scroll">
    <table>
      <tbody>
        <tr><th>Pipeline</th><td><%= link_to @opportunity.pipeline.name, crm_pipeline_path(@opportunity.pipeline) %></td></tr>
        <tr><th>Stage</th><td><%= @opportunity.pipeline_stage.name %></td></tr>
        <tr><th>Amount</th><td><%= crm_money(@opportunity.amount_cents, @opportunity.currency) %></td></tr>
        <tr><th>Expected close</th><td><%= @opportunity.expected_close_on || "—" %></td></tr>
        <tr><th>Company</th><td><%= @opportunity.company ? link_to(@opportunity.company.name, crm_company_path(@opportunity.company)) : "—" %></td></tr>
        <tr><th>Contact</th><td><%= @opportunity.contact ? link_to(@opportunity.contact.display_name, crm_contact_path(@opportunity.contact)) : "—" %></td></tr>
        <tr><th>Owner</th><td><%= crm_user_label(@opportunity.owner) %></td></tr>
        <tr><th>Description</th><td><%= simple_format(@opportunity.description.presence || "—") %></td></tr>
      </tbody>
    </table>
  </div>

  <section class="md-card md-card--outlined md-stack">
    <h2>Move stage</h2>
    <%= form_with url: move_stage_crm_opportunity_path(@opportunity), method: :post, class: "md-actions" do %>
      <%= select_tag :pipeline_stage_id, options_from_collection_for_select(@stages, :id, :name, @opportunity.pipeline_stage_id) %>
      <%= submit_tag "Move", class: "md-button md-button--tonal" %>
    <% end %>
  </section>

  <section class="md-card md-card--outlined md-stack">
    <h2>Assignment</h2>
    <%= form_with url: assign_crm_opportunity_path(@opportunity), method: :post, class: "md-actions" do %>
      <%= select_tag :owner_id, options_from_collection_for_select(@members, :id, :email, @opportunity.owner_id), include_blank: "Unassigned" %>
      <%= submit_tag "Assign owner", class: "md-button md-button--tonal" %>
    <% end %>
  </section>

  <%= render "foundation/crm/shared/timeline",
        record: @opportunity, notes: @notes, tasks: @tasks, activities: @activities,
        note: @note, task: @task, members: @members %>
</section>
