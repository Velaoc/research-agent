<%= render "foundation/crm/shared/errors", record: opportunity %>
<%= form_with model: opportunity, url: opportunity.persisted? ? crm_opportunity_path(opportunity) : crm_opportunities_path, class: "md-stack" do |form| %>
  <div class="md-field"><%= form.label :name %><%= form.text_field :name, required: true, maxlength: 200 %></div>
  <div class="md-field"><%= form.label :amount_cents, "Amount (cents)" %><%= form.number_field :amount_cents, min: 0, step: 1, required: true %></div>
  <div class="md-field"><%= form.label :currency %><%= form.text_field :currency, maxlength: 3, required: true %></div>
  <div class="md-field"><%= form.label :expected_close_on, "Expected close" %><%= form.date_field :expected_close_on %></div>
  <div class="md-field"><%= form.label :description %><%= form.text_area :description, rows: 4 %></div>
  <div class="md-field">
    <%= form.label :pipeline_id, "Pipeline" %>
    <%= form.collection_select :pipeline_id, @pipelines, :id, :name %>
  </div>
  <div class="md-field">
    <%= form.label :pipeline_stage_id, "Stage" %>
    <%= form.collection_select :pipeline_stage_id, @stages, :id, :name %>
  </div>
  <div class="md-field">
    <%= form.label :company_id, "Company" %>
    <%= form.collection_select :company_id, @companies, :id, :name, { include_blank: "None" } %>
  </div>
  <div class="md-field">
    <%= form.label :contact_id, "Contact" %>
    <%= form.collection_select :contact_id, @contacts, :id, :display_name, { include_blank: "None" } %>
  </div>
  <div class="md-field">
    <%= form.label :owner_id, "Owner" %>
    <%= form.collection_select :owner_id, @members, :id, :email, { include_blank: "Unassigned" } %>
  </div>
  <div class="md-actions">
    <%= form.submit class: "md-button md-button--filled" %>
    <%= link_to "Cancel", opportunity.persisted? ? crm_opportunity_path(opportunity) : crm_opportunities_path, class: "md-button md-button--text" %>
  </div>
<% end %>
