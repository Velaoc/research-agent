<%
  classes = class_names("md-button", "md-button--#{variant}", attributes.delete(:class), "is-loading": loading)
  icon_markup = icon.present? ? material_symbol(icon, size: 20) : nil
  body = safe_join([icon_markup, tag.span(label)], "")
  aria = attributes.delete(:aria) || {}
  button_type = attributes.delete(:type) || "button"
  common = attributes.merge(class: classes)
%>
<% if href.present? %>
  <%= tag.a body, **common, href: disabled ? nil : href, aria: aria.merge(disabled: disabled.presence), tabindex: disabled ? -1 : nil %>
<% else %>
  <%= button_tag body, **common, type: button_type, disabled: disabled || loading,
        aria: aria.merge(busy: loading.presence) %>
<% end %>
