# Secrets referenced from config/deploy.yml (env.secret, registry.password,
# accessories/*/env.secret). Values are resolved on the operator machine when
# you run bin/kamal — they are uploaded to the host env file, not baked into
# the image.
#
# Pull from a password manager, the environment, or a local file. DO NOT paste
# raw credentials into this file if you commit it. Command and variable
# substitution are supported.

# Registry (uncomment when registry.password is set in config/deploy.yml)
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails credentials / session signing — never commit config/master.key
RAILS_MASTER_KEY=$(cat config/master.key)

# Primary database (required). Example for the optional db accessory:
# DATABASE_URL=postgres://vela:${POSTGRES_PASSWORD}@vela-foundation-db:5432/vela_foundation_production
DATABASE_URL=$DATABASE_URL

# Object storage when ACTIVE_STORAGE_SERVICE=amazon
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

# Optional — uncomment matching entries under env.secret in config/deploy.yml
# POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# SMTP_USERNAME=$SMTP_USERNAME
# SMTP_PASSWORD=$SMTP_PASSWORD
# STRIPE_PUBLIC_KEY=$STRIPE_PUBLIC_KEY
# STRIPE_PRIVATE_KEY=$STRIPE_PRIVATE_KEY
# STRIPE_SIGNING_SECRET=$STRIPE_SIGNING_SECRET
# STRIPE_PRO_MONTHLY_PRICE_ID=$STRIPE_PRO_MONTHLY_PRICE_ID
# STRIPE_PRO_YEARLY_PRICE_ID=$STRIPE_PRO_YEARLY_PRICE_ID
# STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=$STRIPE_ENTERPRISE_MONTHLY_PRICE_ID
# STRIPE_ENTERPRISE_YEARLY_PRICE_ID=$STRIPE_ENTERPRISE_YEARLY_PRICE_ID
# STOREFRONT_STRIPE_SECRET_KEY=$STOREFRONT_STRIPE_SECRET_KEY
# STOREFRONT_STRIPE_WEBHOOK_SECRET=$STOREFRONT_STRIPE_WEBHOOK_SECRET
# GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET=$GOOGLE_OAUTH_CLIENT_SECRET
# GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET
# CLOUDFLARE_TURNSTILE_SITE_KEY=$CLOUDFLARE_TURNSTILE_SITE_KEY
# CLOUDFLARE_TURNSTILE_SECRET_KEY=$CLOUDFLARE_TURNSTILE_SECRET_KEY

# Password-manager example (1Password adapter):
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account \
#   --from Vault/Item RAILS_MASTER_KEY DATABASE_URL AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY)
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})
# DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
# AWS_ACCESS_KEY_ID=$(kamal secrets extract AWS_ACCESS_KEY_ID ${SECRETS})
# AWS_SECRET_ACCESS_KEY=$(kamal secrets extract AWS_SECRET_ACCESS_KEY ${SECRETS})
